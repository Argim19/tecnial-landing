---
import "../styles/global.css";
const { title = "TECNIAL" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body class="bg-white text-slate-900 overflow-x-hidden">
    <main class="min-h-screen">
      <slot />
    </main>
  </body>
</html>
