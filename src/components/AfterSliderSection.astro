---
const topImages = [
  "/img/demo1.jpg",
  "/img/demo2.jpg",
  "/img/demo3.jpg",
];

const columns = [
  {
    title: "Puertas",
    text: "Galvanizadas, metálicas VIS/VIP, premium en aluminio, ventiladas y de madera para interiores.",
  },
  {
    title: "Ventanas y vidrio",
    text: "Corredizas, batientes y combinadas. Variedad de vidrios, acabados y estanterías en templado.",
  },
  {
    title: "Estructuras",
    text: "Portones, rejas, barandas, escaleras y cerramientos perimetrales con instalación profesional.",
  },
];
---
<section class="relative w-full ">
  <!-- (1) Fondo/textura full width -->
  <div class="relative w-full bg-secondary text-white">
    <!-- Textura opcional (si luego quieres poner una imagen) -->
    <div class="pointer-events-none absolute inset-0 opacity-20 [background-image:radial-gradient(circle_at_20%_20%,#fff_0,transparent_40%),radial-gradient(circle_at_80%_30%,#fff_0,transparent_35%)]"></div>

    <!-- (2) Panel superior: fotos circulares + ola abajo -->
    <!-- -mt-10 hace que quede "pegado" al slider (ajústalo) -->
    <div class="relative z-10">
      <div class="mx-auto max-w-6xl">
        <div class="arc-bottom relative overflow-hidden bg-white py-16 md:py-20">
          <div class="mx-auto max-w-3xl grid grid-cols-2 justify-items-center gap-x-2 gap-y-2 md:flex md:flex-row md:justify-center md:gap-8">
            {topImages.map((src) => (
              <div class="h-36 w-36 overflow-hidden rounded-full md:h-42 md:w-42 last:col-span-2">
                <img src={src} alt="" class="h-full w-full object-cover" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bloque central: 3 columnas de texto sobre el fondo oscuro -->
    <div class="relative z-0 mx-auto max-w-6xl px-4 pb-16 pt-16 md:pt-20">
      <div class="grid gap-10 text-center md:grid-cols-3 md:text-left">
        {columns.map((c) => (
          <div>
            <h3 class="text-lg font-semibold">{c.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/80">
              {c.text}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- (3) Panel inferior: Welcome + ola arriba (centrado y ancho del slider) -->
    <div class="relative z-10">
      <div class="mx-auto max-w-6xl">
        <div class="arc-top relative overflow-hidden bg-white px-6 py-12 text-center text-secondary md:px-12">

          <div class="relative">
            <h2 class="text-4xl font-semibold">Bienvenido</h2>
            <p class="mt-2 text-sm text-slate-800">
              TECNIAL — soluciones arquitectónicas en acero, aluminio, vidrio y madera.
            </p>

            <div class="mx-auto mt-4 h-1 w-20 bg-primary"></div>

            <p class="mx-auto mt-6 max-w-3xl text-sm leading-relaxed">
              Diseñamos, fabricamos e instalamos puertas, ventanas, cerramientos, escaleras y mobiliario,
              con control de calidad y acabados limpios, adaptados a cada proyecto.
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
